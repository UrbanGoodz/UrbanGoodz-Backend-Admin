/* =============================================================
   Urban Goodz — Landing Page Refresh
   Overrides & new sections for the Urban Goodz public landing.
   Does NOT modify the base landing.css.
   ============================================================ */

/* ---- Brand Colors ---- */
:root {
  --ug-orange: #ED9914;
  --ug-canvas: #E2D3BF;
  --ug-dijon: #E5E276;
  --ug-black: #161616;
  --ug-white: #FFFFFF;
  --ug-orange-rgb: 237, 153, 20;
  --ug-primary: var(--ug-orange);
  --ug-primary-dark: #d4880f;
}

/* ---- Nav Overrides ---- */
.main-nav {
  background: var(--ug-black) !important;
  border-bottom: 1px solid rgba(255,255,255,.08) !important;
}
.main-nav .container {
  height: 68px;
}
.nav-links a {
  color: rgba(255,255,255,.7) !important;
  font-size: .82rem;
  font-weight: 600;
  letter-spacing: .02em;
  text-transform: uppercase;
}
.nav-links a:hover,
.nav-links a.active-link {
  color: var(--ug-orange) !important;
}
.nav-logo img {
  height: 36px;
}
.btn-browse-web {
  background: var(--ug-orange) !important;
  border-color: var(--ug-orange) !important;
  color: var(--ug-black) !important;
  font-size: .8rem;
  padding: 7px 18px;
}
.btn-browse-web:hover {
  background: var(--ug-primary-dark) !important;
  border-color: var(--ug-primary-dark) !important;
}
.btn-join {
  border-color: rgba(255,255,255,.25) !important;
  color: var(--ug-white) !important;
  background: transparent !important;
}
.btn-join:hover {
  background: var(--ug-orange) !important;
  border-color: var(--ug-orange) !important;
  color: var(--ug-black) !important;
}
.mob-btn span {
  background: var(--ug-white) !important;
}
.mobile-menu {
  background: var(--ug-black) !important;
}
.mobile-menu a {
  color: rgba(255,255,255,.8) !important;
}
.mobile-menu a:hover {
  color: var(--ug-orange) !important;
}
.mobile-menu .close-mob {
  color: var(--ug-white) !important;
}

/* ---- Hero Overhaul ---- */
.hero {
  background: linear-gradient(170deg, var(--ug-black) 0%, #1a1a1a 40%, #222 70%, var(--ug-black) 100%) !important;
  padding: 60px 0 0 !important;
  min-height: auto;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(var(--ug-orange-rgb), .06) 0%, transparent 70%);
  pointer-events: none;
}
.hero .container {
  position: relative;
  z-index: 2;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 16px;
  background: rgba(var(--ug-orange-rgb), .12);
  border: 1px solid rgba(var(--ug-orange-rgb), .2);
  border-radius: 100px;
  font-size: .72rem;
  font-weight: 700;
  color: var(--ug-orange);
  text-transform: uppercase;
  letter-spacing: .06em;
  margin-bottom: 20px;
}
.hero h1 {
  font-family: 'Syne', sans-serif;
  font-size: 2.6rem;
  font-weight: 800;
  color: var(--ug-white) !important;
  margin-bottom: 12px;
  line-height: 1.2;
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}
.hero h1 .hl {
  color: var(--ug-orange);
}
.hero p {
  font-size: 1rem;
  color: rgba(255,255,255,.65) !important;
  max-width: 600px;
  margin: 0 auto 24px;
  line-height: 1.7;
}
.hero-btns {
  gap: 10px;
}
.hero-btn--primary {
  background: var(--ug-orange);
  color: var(--ug-black);
  border: 2px solid var(--ug-orange);
}
.hero-btn--primary:hover {
  background: var(--ug-primary-dark);
  border-color: var(--ug-primary-dark);
  color: var(--ug-black);
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(var(--ug-orange-rgb), .3);
}
.hero-btn--outline {
  background: transparent;
  color: var(--ug-white);
  border: 2px solid rgba(255,255,255,.25);
}
.hero-btn--outline:hover {
  border-color: var(--ug-orange);
  color: var(--ug-orange);
  transform: translateY(-2px);
}
.hero-launch-line {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,.08);
  font-size: .78rem;
  color: rgba(255,255,255,.4);
  letter-spacing: .04em;
  text-transform: uppercase;
  font-weight: 600;
}
.hero-launch-line strong {
  color: var(--ug-orange);
  font-weight: 700;
}
.hero-illustration {
  opacity: .06 !important;
  color: var(--ug-orange) !important;
}

/* ---- Launch Notice Bar ---- */
.launch-notice {
  background: var(--ug-black);
  border-top: 1px solid rgba(255,255,255,.06);
  border-bottom: 1px solid rgba(255,255,255,.06);
  padding: 14px 0;
  text-align: center;
}
.launch-notice p {
  font-size: .78rem;
  color: rgba(255,255,255,.5);
  margin: 0;
}
.launch-notice strong {
  color: var(--ug-orange);
  font-weight: 700;
}

/* ---- Section Base ---- */
.ug-section {
  padding: 60px 0;
}
.ug-section--dark {
  background: var(--ug-black);
}
.ug-section--canvas {
  background: var(--ug-canvas);
}
.ug-section--dijon {
  background: var(--ug-dijon);
}
.ug-section--light {
  background: #f8f6f3;
}
.ug-section .sec-header {
  text-align: center;
  margin-bottom: 36px;
}
.ug-section .sec-header h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--ug-black);
  margin-bottom: 8px;
}
.ug-section--dark .sec-header h2,
.ug-section--dark .ug-single-section h2,
.ug-section--dark .ug-houston-section h2 {
  color: var(--ug-white);
}
.ug-section .sec-header p {
  font-size: .92rem;
  color: rgba(0,0,0,.55);
  max-width: 560px;
  margin: 0 auto;
  line-height: 1.6;
}
.ug-section--dark .sec-header p {
  color: rgba(255,255,255,.5);
}
.sec-preview-badge {
  display: inline-block;
  margin-bottom: 12px;
  padding: 4px 14px;
  background: rgba(var(--ug-orange-rgb), .12);
  border: 1px solid rgba(var(--ug-orange-rgb), .2);
  border-radius: 100px;
  font-size: .7rem;
  font-weight: 700;
  color: var(--ug-orange);
  text-transform: uppercase;
  letter-spacing: .04em;
}
.ug-section--dark .sec-preview-badge {
  background: rgba(255,255,255,.06);
  border-color: rgba(255,255,255,.1);
  color: var(--ug-orange);
}

/* ---- Cards Grid (10 cards) ---- */
.ug-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  max-width: var(--max-w);
  margin: 0 auto;
}
.ug-cards-grid--10 {
  grid-template-columns: repeat(5, 1fr);
}
.ug-card {
  background: var(--ug-white);
  border-radius: 14px;
  padding: 24px 14px;
  text-align: center;
  border: 1.5px solid rgba(0,0,0,.06);
  transition: all .3s ease;
  cursor: default;
}
.ug-card:hover {
  transform: translateY(-4px);
  border-color: var(--ug-orange);
  box-shadow: 0 0 0 1px var(--ug-orange), 0 12px 32px rgba(var(--ug-orange-rgb), .1);
}
.ug-card .card-icon {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--ug-black);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  margin: 0 auto 12px;
  color: var(--ug-white);
}
.ug-card h4 {
  font-size: .83rem;
  font-weight: 700;
  color: var(--ug-black);
  margin-bottom: 2px;
}
.ug-card p {
  font-size: .73rem;
  color: rgba(0,0,0,.45);
  margin: 0;
  line-height: 1.4;
}

/* ---- Ask Urban Goodz Section ---- */
.ug-ask-grid {
  max-width: 680px;
  margin: 0 auto;
}
.ug-ask-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-bottom: 28px;
}
.ug-chip {
  padding: 8px 18px;
  border-radius: 100px;
  border: 1.5px solid rgba(255,255,255,.15);
  background: rgba(255,255,255,.04);
  color: rgba(255,255,255,.75);
  font-size: .82rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .25s ease;
}
.ug-chip:hover {
  border-color: var(--ug-orange);
  color: var(--ug-orange);
  background: rgba(var(--ug-orange-rgb), .08);
}
.ug-ask-search {
  text-align: center;
}
.ug-search-bar {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  max-width: 480px;
  padding: 14px 20px;
  border-radius: 60px;
  background: rgba(255,255,255,.06);
  border: 1.5px solid rgba(255,255,255,.12);
}
.ug-search-icon {
  font-size: 1.2rem;
  opacity: .5;
}
.ug-search-bar input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--ug-white);
  font-size: .92rem;
  font-weight: 500;
}
.ug-search-bar input::placeholder {
  color: rgba(255,255,255,.3);
}
.ug-search-hint {
  font-size: .68rem;
  color: rgba(255,255,255,.25);
  text-transform: uppercase;
  letter-spacing: .04em;
  white-space: nowrap;
}

/* ---- Single Section Layout (Order Anywhere, Rentals, etc.) ---- */
.ug-single-section {
  text-align: center;
  max-width: 680px;
  margin: 0 auto;
}
.ug-single-icon {
  font-size: 2.2rem;
  margin-bottom: 12px;
}
.ug-single-section h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--ug-black);
  margin-bottom: 10px;
}
.ug-single-copy {
  font-size: .94rem;
  color: rgba(0,0,0,.55);
  line-height: 1.7;
  margin-bottom: 20px;
}
.ug-section--dark .ug-single-copy {
  color: rgba(255,255,255,.5);
}
.ug-single-sub {
  font-size: .84rem;
  color: rgba(0,0,0,.45);
  line-height: 1.6;
  margin-bottom: 20px;
  max-width: 540px;
  margin-left: auto;
  margin-right: auto;
}
.ug-status-box {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px 18px;
  border-radius: 12px;
  background: rgba(var(--ug-orange-rgb), .06);
  border: 1px solid rgba(var(--ug-orange-rgb), .12);
  margin-bottom: 22px;
  text-align: left;
}
.ug-status-box p {
  font-size: .8rem;
  color: rgba(0,0,0,.5);
  margin: 0;
  line-height: 1.5;
}
.ug-section--dark .ug-status-box p {
  color: rgba(255,255,255,.5);
}
.ug-status-box .status-badge {
  flex-shrink: 0;
  margin-top: 1px;
}

/* ---- Two Column Mini Cards (Services) ---- */
.ug-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  max-width: 600px;
  margin: 0 auto 24px;
}
.ug-mini-card {
  background: var(--ug-white);
  border-radius: 12px;
  padding: 20px 18px;
  text-align: left;
  border: 1px solid rgba(0,0,0,.06);
}
.ug-mini-card h4 {
  font-size: .9rem;
  font-weight: 700;
  color: var(--ug-black);
  margin-bottom: 6px;
}
.ug-mini-card p {
  font-size: .78rem;
  color: rgba(0,0,0,.5);
  line-height: 1.5;
  margin-bottom: 10px;
}

/* ---- Earn Grid (7 earning paths) ---- */
.ug-earn-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  max-width: 860px;
  margin: 0 auto 28px;
}
.ug-earn-card {
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 12px;
  padding: 20px 16px;
  text-align: center;
  transition: all .3s ease;
}
.ug-earn-card:hover {
  border-color: var(--ug-orange);
  background: rgba(var(--ug-orange-rgb), .06);
  transform: translateY(-2px);
}
.ug-earn-num {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--ug-orange);
  color: var(--ug-black);
  font-size: .75rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
}
.ug-earn-card h4 {
  font-size: .82rem;
  font-weight: 700;
  color: var(--ug-white);
  margin-bottom: 4px;
}
.ug-earn-card p {
  font-size: .72rem;
  color: rgba(255,255,255,.45);
  margin: 0;
  line-height: 1.4;
}
.ug-earn-card .lbl-sm {
  font-size: .65rem;
  font-weight: 600;
  color: rgba(255,255,255,.3);
}
.ug-earn-cta {
  text-align: center;
}

/* ---- Houston Section ---- */
.ug-houston-section {
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}
.ug-houston-icon {
  font-size: 2.4rem;
  margin-bottom: 12px;
}
.ug-houston-section h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--ug-white);
  margin-bottom: 10px;
}
.ug-houston-section p {
  font-size: .94rem;
  color: rgba(255,255,255,.5);
  line-height: 1.7;
  margin-bottom: 16px;
}
.ug-houston-line {
  font-size: .9rem;
  color: var(--ug-dijon);
  font-weight: 700;
  margin-bottom: 12px;
}
.ug-houston-tagline {
  font-size: .78rem;
  color: rgba(255,255,255,.35);
  text-transform: uppercase;
  letter-spacing: .06em;
  font-weight: 600;
}

/* ---- 3-Column CTA ---- */
.ug-cta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  max-width: var(--max-w);
  margin: 0 auto;
}
.ug-cta-card {
  background: var(--ug-white);
  border-radius: 16px;
  padding: 36px 28px;
  text-align: center;
  border: 1px solid rgba(0,0,0,.06);
  transition: all .3s ease;
}
.ug-cta-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(0,0,0,.08);
}
.ug-cta-card .cta-emoji {
  font-size: 2.2rem;
  margin-bottom: 14px;
}
.ug-cta-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--ug-black);
  margin-bottom: 6px;
}
.ug-cta-card p {
  font-size: .84rem;
  color: rgba(0,0,0,.5);
  line-height: 1.6;
  margin-bottom: 18px;
}
.ug-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 24px;
  border-radius: 100px;
  font-size: .82rem;
  font-weight: 700;
  background: var(--ug-orange);
  color: var(--ug-black);
  border: 2px solid var(--ug-orange);
  transition: all .3s ease;
  cursor: pointer;
  text-decoration: none;
}
.ug-cta-btn:hover {
  background: var(--ug-primary-dark);
  border-color: var(--ug-primary-dark);
  color: var(--ug-black);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(var(--ug-orange-rgb), .25);
  text-decoration: none;
}
.ug-cta-btn--outline {
  background: transparent;
  color: var(--ug-black);
  border-color: rgba(0,0,0,.15);
}
.ug-cta-btn--outline:hover {
  border-color: var(--ug-orange);
  color: var(--ug-orange);
  background: transparent;
  box-shadow: none;
}

/* ---- Market Network Section ---- */
.ug-mkt-network {
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}
.ug-mkt-icon {
  font-size: 2.2rem;
  margin-bottom: 12px;
}
.ug-mkt-network h2 {
  font-family: 'Syne', sans-serif;
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--ug-white);
  margin-bottom: 14px;
}
.ug-mkt-network p {
  font-size: .88rem;
  color: rgba(255,255,255,.5);
  line-height: 1.7;
  margin-bottom: 12px;
}
.ug-mkt-hubs {
  display: grid;
  gap: 10px;
  max-width: 520px;
  margin: 20px auto 24px;
  text-align: left;
}
.ug-mkt-hub {
  padding: 12px 16px;
  border-radius: 10px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
}
.ug-mkt-label {
  display: block;
  font-size: .7rem;
  font-weight: 700;
  color: var(--ug-orange);
  text-transform: uppercase;
  letter-spacing: .04em;
  margin-bottom: 3px;
}
.ug-mkt-value {
  display: block;
  font-size: .84rem;
  color: rgba(255,255,255,.7);
  line-height: 1.5;
}

/* ---- Status Badges ---- */
.status-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 100px;
  font-size: .68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
}
.status-badge--preview {
  background: rgba(var(--ug-orange-rgb), .1);
  color: var(--ug-orange);
}
.status-badge--live {
  background: rgba(0,190,101,.1);
  color: #00BE65;
}

/* ---- Footer Overrides ---- */
.footer {
  background: var(--ug-black) !important;
}
.footer h2, .footer h5 {
  color: var(--ug-white) !important;
}
.footer p, .footer a {
  color: rgba(255,255,255,.5) !important;
}
.footer a:hover {
  color: var(--ug-orange) !important;
}
.footer .newsletter-area button {
  background: var(--ug-orange) !important;
  color: var(--ug-black) !important;
  font-weight: 700;
}
.footer .newsletter-area button:hover {
  background: var(--ug-primary-dark) !important;
}

/* ---- Responsive ---- */
@media (max-width: 992px) {
  .ug-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .ug-cards-grid--10 {
    grid-template-columns: repeat(3, 1fr);
  }
  .ug-cta-grid {
    grid-template-columns: 1fr;
    max-width: 440px;
  }
  .ug-two-col {
    grid-template-columns: 1fr;
    max-width: 440px;
  }
  .ug-earn-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .hero h1 {
    font-size: 2rem;
  }
}
@media (max-width: 576px) {
  .hero h1 {
    font-size: 1.5rem;
  }
  .hero p {
    font-size: .88rem;
  }
  .hero {
    padding: 40px 0 0 !important;
  }
  .ug-section {
    padding: 40px 0;
  }
  .ug-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .ug-cards-grid--10 {
    grid-template-columns: repeat(2, 1fr);
  }
  .ug-card {
    padding: 18px 10px;
  }
  .ug-card .card-icon {
    width: 36px;
    height: 36px;
    font-size: 1rem;
  }
  .ug-card h4 {
    font-size: .76rem;
  }
  .ug-earn-grid {
    grid-template-columns: 1fr 1fr;
  }
  .ug-earn-card {
    padding: 16px 12px;
  }
  .ug-ask-chips {
    gap: 6px;
  }
  .ug-chip {
    font-size: .74rem;
    padding: 6px 14px;
  }
  .ug-single-section h2,
  .ug-houston-section h2,
  .ug-mkt-network h2 {
    font-size: 1.25rem;
  }
  .ug-mkt-network p {
    font-size: .82rem;
  }
}
