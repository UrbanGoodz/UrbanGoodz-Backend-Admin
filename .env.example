APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=dev

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_food_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
BROADCAST_DRIVER="${BROADCAST_CONNECTION}"
CACHE_DRIVER=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_TIMEOUT=30
MAIL_AUTH_MODE=null
MAIL_EHLO_DOMAIN=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

REVERB_APP_ID=6ammart
REVERB_APP_KEY=6ammart
REVERB_APP_SECRET=6ammart
REVERB_HOST="${APP_URL}"
REVERB_PORT=6001
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=us2
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https

MIX_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Urban Goodz AI provider (openai|openrouter|gemini|disabled)
AI_PROVIDER=openai
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=1
AI_RETRY_DELAY_MS=250
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.4

# Gemini is server-side only. Use a key restricted to the Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter is optional and is used only when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL="${APP_URL}"
OPENROUTER_APP_NAME="Urban Goodz"
SOFTWARE_VERSION=3.9

# Urban Goodz Payments (Adyen)
URBAN_GOODZ_PAYMENT_MODE=staged_test
URBAN_GOODZ_ADYEN_ENABLED=false
URBAN_GOODZ_ADYEN_ENV=sandbox
URBAN_GOODZ_ADYEN_API_KEY=
URBAN_GOODZ_ADYEN_MERCHANT_ACCOUNT=
URBAN_GOODZ_ADYEN_CLIENT_KEY=
URBAN_GOODZ_ADYEN_HMAC_KEY=
URBAN_GOODZ_ADYEN_USERNAME=
URBAN_GOODZ_ADYEN_PASSWORD=
URBAN_GOODZ_ADYEN_ORIGIN=https://localhost
URBAN_GOODZ_ADYEN_RETURN_URL=https://localhost/adyen/callback
URBAN_GOODZ_STAGED_TEST_ENABLED=true
URBAN_GOODZ_CURRENCY=USD
URBAN_GOODZ_PLATFORM_FEE_PERCENT=10

# Cloudflare Turnstile (free plan). Site keys are public; secrets are server-side only.
# Admin widget covers admin.urbangoodzdelivery.com.
TURNSTILE_ADMIN_SITE_KEY=
TURNSTILE_ADMIN_SECRET_KEY=
# Web widget covers urbangoodzdelivery.com, www.urbangoodzdelivery.com and the
# Business Portal, which is served from /business on the same hostname.
TURNSTILE_WEB_SITE_KEY=
TURNSTILE_WEB_SECRET_KEY=

# OpenRouteService road distances (free plan). Not the same service as OPENROUTER_*.
# Free tier: 2,000 matrix and 2,000 directions requests/day, 40/min.
ORS_API_KEY=

# Google AI Studio / Gemini. gemini-2.5-* is closed to new keys; use a -latest alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Fashion Fit AI measurement provider (server-side only)
# provider=silhouette runs the in-platform engine (needs the GD extension).
# provider=http delegates to an external vendor and needs endpoint/api_key/model.
FASHION_FIT_AI_ENABLED=true
FASHION_FIT_AI_PROVIDER=silhouette
FASHION_FIT_AI_ENDPOINT=
FASHION_FIT_AI_API_KEY=
FASHION_FIT_AI_MODEL=
FASHION_FIT_AI_MODEL_VERSION=
FASHION_FIT_AI_TIMEOUT=90
FASHION_FIT_AI_MAX_ATTEMPTS=3
FASHION_FIT_STAGED_PAYMENTS_ENABLED=false
FASHION_FIT_CONSENT_VERSION=2026-07-12

# Service booking sandbox payment provider (server-side only)
SERVICE_BOOKING_PLATFORM_FEE_PERCENT=15
SERVICE_BOOKING_PAYMENT_SANDBOX=true
SERVICE_BOOKING_PAYMENT_PROVIDER=stripe
SERVICE_BOOKING_STRIPE_ENDPOINT=https://api.stripe.com/v1/payment_intents
SERVICE_BOOKING_PAYMENT_TIMEOUT=30

# ==================================================
# Firebase (Push Notifications)
# ==================================================
FIREBASE_PROJECT=urbangoodzdelivery
FIREBASE_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_DEFAULT_BUCKET=urbangoodzdelivery.appspot.com
FIREBASE_CACHE_STORE=file
URBAN_GOODZ_ISSUING_PROVIDER=disabled
URBAN_GOODZ_CARDS_MODE=sandbox
URBAN_GOODZ_MAX_DRIVER_CARD_AMOUNT=50
URBAN_GOODZ_DRIVER_CARD_BUFFER_PERCENT=0
URBAN_GOODZ_DRIVER_CARD_DEFAULT_EXPIRY_MINUTES=120
STRIPE_ISSUING_WEBHOOK_SECRET=
STRIPE_ISSUING_API_VERSION=2026-06-24.dahlia
STRIPE_ISSUING_ALLOWED_CARD_PRESENCES=not_present
STRIPE_ISSUING_ALLOWED_MERCHANT_COUNTRIES=US
URBAN_GOODZ_ISSUING_BILLING_LINE1=
URBAN_GOODZ_ISSUING_BILLING_CITY=
URBAN_GOODZ_ISSUING_BILLING_STATE=
URBAN_GOODZ_ISSUING_BILLING_POSTAL_CODE=
URBAN_GOODZ_ISSUING_BILLING_COUNTRY=US
